# Vault Radar MCP 서버 환경변수
# 사용법: cp .env.example .env && chmod 600 .env 후 값 입력
# run-mcp.sh 가 source 로 읽으므로 "export KEY=값" 형식도 됩니다.

# HCP 프로젝트 ID (Project settings > Project ID)
export HCP_PROJECT_ID=

# 프로젝트 수준 서비스 주체 키 (viewer 역할 권장)
export HCP_CLIENT_ID=
export HCP_CLIENT_SECRET=

# (선택) vault-radar agent 사용 시에만 필요. MCP 서버는 사용하지 않음
# export HCP_RADAR_AGENT_POOL_ID=
