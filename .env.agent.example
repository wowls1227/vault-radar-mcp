# Vault Radar Agent 환경변수 (MCP용 .env 와 분리)
# 사용법: cp .env.agent.example .env.agent && chmod 600 .env.agent 후 값 입력
# 서비스 주체: 프로젝트 수준, "Vault Radar Agent" 역할 (MCP용 Viewer 키와 별도)

export HCP_PROJECT_ID=
export HCP_CLIENT_ID=
export HCP_CLIENT_SECRET=

# HCP 포털 > Vault Radar > Settings > Agent > (agent pool) > Connect the agent 에서 복사
export HCP_RADAR_AGENT_POOL_ID=

# 데이터 소스 자격 증명: HCP 포털에서 env://VAULT_RADAR_GIT_TOKEN 형태로 입력
# 예) GitHub PAT (대상 저장소 읽기 권한만)
# export VAULT_RADAR_GIT_TOKEN=

# (선택) 로그 수준: trace, debug, info, warn, error
# export VAULT_RADAR_LOG_LEVEL=info
